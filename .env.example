# Copie para .env (nao versionado) e preencha.

# Chave HMAC do JWT: Base64 de 32 bytes ALEATORIOS (256 bits, minimo do HS256).
# Gere com um destes (nunca use uma palavra/frase):
#   openssl rand -base64 32
#   PowerShell: $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET_KEY=

# Seed do primeiro ADMIN no account (ver README do Account-service).
# Hash = Base64(SHA-256(senha)), gerado com:
#   printf '%s' 'suaSenha' | openssl dgst -sha256 -binary | base64
ACCOUNT_ADMIN_EMAIL=
ACCOUNT_ADMIN_HASH=

# Opcionais (defaults no application.yaml)
# JWT_DURATION=3600000
# JWT_HTTP_ONLY=true
# Flag Secure do cookie. true: Secure + SameSite=None (HTTPS ou localhost).
# false: sem Secure + SameSite=Lax, para acesso por HTTP puro (ex.: Load Balancer
# do EKS sem dominio/HTTPS). Com false o JWT trafega em claro; em producao use
# HTTPS (dominio + ACM) e deixe true.
# JWT_COOKIE_SECURE=true
